{
  "name": "qr-simple",
  "image": "mcr.microsoft.com/devcontainers/dotnet:1-10.0",
  "remoteUser": "vscode",
  // The CLI's own UID-matching step (which rebuilds the image via a
  // generated Dockerfile in ITS OWN /tmp) doesn't work through the
  // flatpak-spawn --host bridge: that Dockerfile lives in the Flatpak
  // sandbox's private /tmp, invisible to the real host process that
  // podman-for-vscode.sh actually execs into, so "docker build -f
  // <path>" fails with "no such file or directory" even though the file
  // is right there from the sandbox's own point of view. We don't need
  // this anyway -- --userns=keep-id below already makes the container's
  // vscode user (UID 1000) match the host UID correctly.
  "updateRemoteUserUID": false,
  // Mounts the host's rootless podman socket so Testcontainers (run from
  // inside this container) talks straight to the host's podman -- no nested
  // container runtime. Path assumes host UID 1000 (this machine's tsogtb
  // user); adjust if `id -u` differs.
  //
  // --userns=keep-id: without it, rootless podman remaps host UID 1000 to a
  // different UID inside the container's user namespace, so the vscode user
  // (UID 1000 in-container) no longer matches the socket's actual owner and
  // gets permission-denied on connect (verified: `ls` on the socket succeeds
  // either way -- stat doesn't need matching perms -- but an actual API call
  // over it fails until UIDs truly line up).
  // security-opt label=disable: an SELinux relabel on this bind mount (the
  // default behavior of Podman/Docker's ":Z" mount suffix) breaks the HOST's
  // own access to the socket, not just the container's -- verified by
  // reproducing the failure with a plain `podman run -v ...:Z` and fixing it
  // by disabling label confinement for this specific mount instead.
  // --network=host: Testcontainers, run from inside this container, creates
  // its Postgres container as a SIBLING (via the mounted host socket), not a
  // child -- they don't share a network namespace by default. Rootless
  // podman also only publishes sibling ports on the HOST's loopback, not to
  // other containers. Sharing the host's network namespace here is what
  // makes "localhost:<published-port>" resolve to the right place. Verified:
  // omitting this reproduces exactly Npgsql "connection refused" even though
  // the sibling Postgres container starts successfully.
  "runArgs": ["--userns=keep-id", "--security-opt", "label=disable", "--network=host"],
  "mounts": [
    "source=/run/user/1000/podman/podman.sock,target=/var/run/docker.sock,type=bind",
    // Keep this app's local database/OAuth configuration across container
    // rebuilds without exposing the host's user-secrets for unrelated apps.
    "source=${localEnv:HOME}/.microsoft/usersecrets/b1a96fde-ea71-4042-810e-3c5ed008f005,target=/home/vscode/.microsoft/usersecrets/b1a96fde-ea71-4042-810e-3c5ed008f005,type=bind"
  ],
  "containerEnv": {
    "DOCKER_HOST": "unix:///var/run/docker.sock",
    "TESTCONTAINERS_RYUK_DISABLED": "true",
    // `dotnet dev-certs https --trust` trusts the dev cert in two separate
    // places on Linux: the NSS database (what Chrome/browsers read) and an
    // OpenSSL-format export -- but the OpenSSL half only takes effect if
    // SSL_CERT_DIR points at it. Without this, `--trust` silently only does
    // half its job: it prints "Successfully trusted..." regardless, but a
    // follow-up `dotnet dev-certs https --check --trust` (or anything relying
    // on OpenSSL/curl-style trust) still reports the cert as untrusted.
    // Verified 2026-08-16.
    "SSL_CERT_DIR": "/home/vscode/.aspnet/dev-certs/trust:/usr/lib/ssl/certs"
  },
  // This container shares the host network, so an app listening on localhost
  // is already reachable from Fedora at the same port. VS Code's automatic
  // forwarding is redundant here and can claim that host port itself, leaving
  // the real app unable to bind (or creating a forwarding loop that hangs).
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "customizations": {
    "vscode": {
      // anthropic.claude-code / openai.chatgpt were previously installed by
      // hand, which only persists in one container's writable layer -- a
      // rebuild (not just a restart) wipes them, same as everything else
      // outside a mount. Declaring them here makes VS Code auto-reinstall on
      // every rebuild, same as the two .NET extensions already were.
      "extensions": ["ms-dotnettools.csdevkit", "ms-dotnettools.csharp", "anthropic.claude-code", "openai.chatgpt"]
    }
  },
  // libfontconfig1 is missing from this base image; SkiaSharp needs it even
  // just to render a QR code, not only for text. Without it every QrCode /
  // ScanPage test aborts the whole run (native crash during GC finalization,
  // not a clean test failure). `apt-get update` exits 100 here regardless,
  // because the image ships an unrelated unsigned yarn.pkg apt source -- that
  // failure is harmless and expected; don't let it short-circuit the install.
  // dotnet dev-certs isn't mounted from the host, so a rebuild always starts
  // with no HTTPS dev certificate -- the `https` launch profile (required for
  // Google sign-in locally, since the OAuth redirect_uri is registered
  // against localhost:7040) fails outright until this runs once by hand.
  // Running it here every time is a harmless no-op if a cert already exists.
  // libnss3-tools provides certutil, which dev-certs needs to actually write
  // into the NSS trust database (without it, --trust silently does nothing
  // real). ~/.pki/nssdb also doesn't exist by default in this image --
  // certutil -N creates it; `|| true` makes this safe to re-run if it's ever
  // already initialized. All verified 2026-08-16 against a genuinely fresh
  // rebuild -- see AGENTS.md's Deployment/environment notes for the full
  // debugging trail if this regresses again.
  "postCreateCommand": "sudo apt-get update -qq; sudo apt-get install -y -qq libfontconfig1 libnss3-tools && dotnet restore && mkdir -p ~/.pki/nssdb && (certutil -d sql:$HOME/.pki/nssdb -N --empty-password || true) && dotnet dev-certs https --trust"
}
