@inherits LayoutComponentBase
@inject IDbContextFactory<AppDbContext> DbFactory

<div class="page">
    <header class="site-header">
        <a class="brand" href="/app">qr-simple</a>
        <nav class="nav-links">
            <AuthorizeView>
                <Authorized>
                    @if (IsAdmin)
                    {
                        <a href="/app/users">Users</a>
                        <a href="/app/categories">Categories</a>
                    }
                    <span class="user-email">@context.User.FindFirst(ClaimTypes.Email)?.Value</span>
                    <form method="post" action="/logout" class="signout-form">
                        <button type="submit" class="btn btn-ghost">Sign out</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-primary" href="/login">Sign in with Google</a>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </header>
    <main class="content">
        @Body
    </main>
</div>
<ToastHost />

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    private bool IsAdmin;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask!;
        var email = authState.User.FindFirst(ClaimTypes.Email)?.Value;

        await using var db = await DbFactory.CreateDbContextAsync();
        var user = await UserAuthorization.FindAsync(email, db);
        IsAdmin = user is { IsActive: true, Role: Roles.Admin };
    }
}
