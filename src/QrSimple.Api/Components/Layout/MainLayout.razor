@inherits LayoutComponentBase
@inject IDbContextFactory<AppDbContext> DbFactory

<div class="page">
    <header class="site-header">
        <a class="brand" href="/app">
            <img class="brand-logo" src="/brand/logos/ics-logo.png" alt="ICS Mongolia" width="1381" height="678" />
            <span class="brand-name">Equipment Registry</span>
        </a>
        <nav class="nav-links">
            <AuthorizeView>
                <Authorized>
                    @if (IsAdmin)
                    {
                        <a href="/app/users"><Icon Name="users" />Users</a>
                        <a href="/app/categories"><Icon Name="tag" />Categories</a>
                    }
                    <span class="user-email"><Icon Name="user" />@context.User.FindFirst(ClaimTypes.Email)?.Value</span>
                    <form method="post" action="/logout" class="signout-form">
                        <button type="submit" class="btn btn-ghost"><Icon Name="log-out" />Sign out</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-primary" href="/login"><Icon Name="log-in" />Sign in with Google</a>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </header>
    <main class="content">
        @Body
    </main>
</div>
<ToastHost />

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    private bool IsAdmin;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask!;
        var email = authState.User.FindFirst(ClaimTypes.Email)?.Value;

        await using var db = await DbFactory.CreateDbContextAsync();
        var user = await UserAuthorization.FindAsync(email, db);
        IsAdmin = user is { IsActive: true, Role: Roles.Admin };
    }
}
