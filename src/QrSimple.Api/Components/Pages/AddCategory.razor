@page "/app/categories/add"
@attribute [Authorize]
@inherits RoleGatedComponentBase

<Breadcrumbs Items="@(new() { new("Categories", "/app/categories"), new("Add category") })" />

<h1>Add category</h1>

<div class="form-card">
    <EditForm Model="Model" OnValidSubmit="SubmitAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div>
            <label>Name <InputText @bind-Value="Model.Name" /></label>
            <ValidationMessage For="() => Model.Name" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@IsSaving">@(IsSaving ? "Adding..." : "Add")</button>
    </EditForm>
</div>

@if (Error is not null)
{
    <p class="error">@Error</p>
}

@code {
    protected override string[] AllowedRoles => [Roles.Admin];

    private readonly AddCategoryModel Model = new();
    private string? Error;
    private bool IsSaving;

    private async Task SubmitAsync()
    {
        Error = null;
        IsSaving = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await CategoryCatalog.CreateAsync(Model.Name, db);

            switch (result)
            {
                case CategoryResult.Success:
                    Toast.Success("Category added.");
                    Navigation.NavigateTo("/app/categories");
                    break;
                case CategoryResult.DuplicateName dup:
                    Error = $"A category named \"{dup.Name}\" already exists.";
                    Toast.Error(Error);
                    break;
                default:
                    Error = "Could not add category.";
                    Toast.Error(Error);
                    break;
            }
        }
        finally
        {
            IsSaving = false;
        }
    }

    private sealed class AddCategoryModel
    {
        [Required]
        public string Name { get; set; } = "";
    }
}
