@page "/app/categories/add"
@attribute [Authorize]
@inherits RoleGatedComponentBase

<h1>Add category</h1>

<div class="form-card">
    <EditForm Model="Model" OnValidSubmit="SubmitAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div>
            <label>Name <InputText @bind-Value="Model.Name" /></label>
        </div>

        <button type="submit" class="btn btn-primary">Add</button>
    </EditForm>
</div>

@if (Error is not null)
{
    <p class="error">@Error</p>
}

<p><a href="/app/categories">Back to categories</a></p>

@code {
    protected override string[] AllowedRoles => [Roles.Admin];

    private readonly AddCategoryModel Model = new();
    private string? Error;

    private async Task SubmitAsync()
    {
        Error = null;

        await using var db = await DbFactory.CreateDbContextAsync();
        var result = await CategoryCatalog.CreateAsync(Model.Name, db);

        switch (result)
        {
            case CategoryResult.Success:
                Toast.Show("Category added.");
                Navigation.NavigateTo("/app/categories");
                break;
            case CategoryResult.DuplicateName dup:
                Error = $"A category named \"{dup.Name}\" already exists.";
                break;
            default:
                Error = "Could not add category.";
                break;
        }
    }

    private sealed class AddCategoryModel
    {
        [Required]
        public string Name { get; set; } = "";
    }
}
