@page "/app/equipment/add"
@attribute [Authorize]
@inherits RoleGatedComponentBase

<Breadcrumbs Items="@(new() { new("Equipment", "/app"), new("Add equipment") })" />

<h1>Add equipment</h1>

@if (Categories is not null && Categories.Count == 0)
{
    <p>No categories yet — <a href="/app/categories/add">add one first</a>.</p>
}

<div class="form-card">
    <EditForm Model="Model" OnValidSubmit="SubmitAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div>
            <label>Name <InputText @bind-Value="Model.Name" /></label>
            <ValidationMessage For="() => Model.Name" />
        </div>
        <div>
            <label>
                Category
                <InputSelect @bind-Value="Model.Category">
                    <option value="">-- select --</option>
                    @if (Categories is not null)
                    {
                        @foreach (var category in Categories)
                        {
                            <option value="@category.Name">@category.Name</option>
                        }
                    }
                </InputSelect>
            </label>
            <ValidationMessage For="() => Model.Category" />
        </div>
        <div>
            <label>Serial number <InputText @bind-Value="Model.SerialNumber" /></label>
            <ValidationMessage For="() => Model.SerialNumber" />
        </div>
        <div>
            <label>Site <InputText @bind-Value="Model.Site" /></label>
            <ValidationMessage For="() => Model.Site" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@IsSaving">@(IsSaving ? "Adding..." : "Add")</button>
    </EditForm>
</div>

@if (Error is not null)
{
    <p class="error">@Error</p>
}

@code {
    protected override string[] AllowedRoles => [Roles.Admin, Roles.Operator];

    private List<Category>? Categories;
    private readonly AddEquipmentModel Model = new();
    private string? Error;
    private bool IsSaving;

    protected override async Task OnAuthorizedInitializedAsync(AppDbContext db)
    {
        Categories = await db.Categories.OrderBy(c => c.Name).ToListAsync();
    }

    private async Task SubmitAsync()
    {
        Error = null;
        IsSaving = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var request = new CreateEquipmentRequest(Model.Name, Model.Category, Model.SerialNumber, Model.Site);
            var result = await EquipmentCatalog.CreateAsync(request, db);

            switch (result)
            {
                case EquipmentResult.Success success:
                    Toast.Success("Equipment added.");
                    Navigation.NavigateTo($"/app/equipment/{success.Equipment.Id}");
                    break;
                case EquipmentResult.UnknownCategory unknown:
                    Error = $"Unknown category: {unknown.Category}";
                    Toast.Error(Error);
                    break;
                default:
                    Error = "Could not add equipment.";
                    Toast.Error(Error);
                    break;
            }
        }
        finally
        {
            IsSaving = false;
        }
    }

    private sealed class AddEquipmentModel
    {
        [Required]
        public string Name { get; set; } = "";

        [Required]
        public string Category { get; set; } = "";

        [Required]
        public string SerialNumber { get; set; } = "";

        [Required]
        public string Site { get; set; } = "";
    }
}
