@page "/app/users/add"
@attribute [Authorize]
@inherits RoleGatedComponentBase

<Breadcrumbs Items="@(new() { new("Users", "/app/users"), new("Add user") })" />

<h1>Add user</h1>

<div class="form-card">
    <EditForm Model="Model" OnValidSubmit="SubmitAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div>
            <label>Email <InputText @bind-Value="Model.Email" /></label>
            <ValidationMessage For="() => Model.Email" />
        </div>
        <div>
            <label>
                Role
                <InputSelect @bind-Value="Model.Role">
                    <option value="">-- select --</option>
                    @foreach (var role in Roles.All)
                    {
                        <option value="@role">@role</option>
                    }
                </InputSelect>
            </label>
            <ValidationMessage For="() => Model.Role" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@IsSaving">@(IsSaving ? "Adding..." : "Add")</button>
    </EditForm>
</div>

@if (Error is not null)
{
    <p class="error">@Error</p>
}

@code {
    protected override string[] AllowedRoles => [Roles.Admin];

    private readonly AddUserModel Model = new();
    private string? Error;
    private bool IsSaving;

    private async Task SubmitAsync()
    {
        Error = null;
        IsSaving = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await UserCatalog.CreateAsync(Model.Email, Model.Role, db);

            switch (result)
            {
                case UserResult.Success success:
                    Toast.Success("User added.");
                    Navigation.NavigateTo($"/app/users/{success.User.Id}");
                    break;
                case UserResult.DuplicateEmail dup:
                    Error = $"A user with email {dup.Email} already exists.";
                    Toast.Error(Error);
                    break;
                case UserResult.UnknownRole unknown:
                    Error = $"Unknown role: {unknown.Role}";
                    Toast.Error(Error);
                    break;
                default:
                    Error = "Could not add user.";
                    Toast.Error(Error);
                    break;
            }
        }
        finally
        {
            IsSaving = false;
        }
    }

    private sealed class AddUserModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        public string Role { get; set; } = "";
    }
}
