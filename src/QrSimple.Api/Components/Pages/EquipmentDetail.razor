@page "/app/equipment/{Id:guid}"
@attribute [Authorize]
@inherits RoleGatedComponentBase

@if (Item is null)
{
    <p>Equipment not found.</p>
}
else
{
    <Breadcrumbs Items="@(new() { new("Equipment", "/app"), new(Item.Name) })" />

    <h1>@Item.Name</h1>

    @if (CanEditNameAndSerialNumber)
    {
        <div class="form-card">
            <EditForm Model="Model" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div>
                    <label>Name <InputText @bind-Value="Model.Name" /></label>
                    <ValidationMessage For="() => Model.Name" />
                </div>
                <div>
                    <label>
                        Category
                        <InputSelect @bind-Value="Model.Category">
                            @foreach (var category in Categories!)
                            {
                                <option value="@category.Name">@category.Name</option>
                            }
                        </InputSelect>
                    </label>
                    <ValidationMessage For="() => Model.Category" />
                </div>
                <div>
                    <label>Serial number <InputText @bind-Value="Model.SerialNumber" /></label>
                    <ValidationMessage For="() => Model.SerialNumber" />
                </div>
                <div>
                    <label>Site <InputText @bind-Value="Model.Site" /></label>
                    <ValidationMessage For="() => Model.Site" />
                </div>

                <button type="submit" class="btn btn-primary" disabled="@IsBusy"><Icon Name="check-circle" />@(IsBusy ? "Saving..." : "Save")</button>
            </EditForm>
        </div>
    }
    else if (CanEditCategoryAndSite)
    {
        <dl>
            <dt>Serial number</dt>
            <dd>@Item.SerialNumber</dd>
        </dl>

        <div class="form-card">
            <EditForm Model="Model" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div>
                    <label>
                        Category
                        <InputSelect @bind-Value="Model.Category">
                            @foreach (var category in Categories!)
                            {
                                <option value="@category.Name">@category.Name</option>
                            }
                        </InputSelect>
                    </label>
                    <ValidationMessage For="() => Model.Category" />
                </div>
                <div>
                    <label>Site <InputText @bind-Value="Model.Site" /></label>
                    <ValidationMessage For="() => Model.Site" />
                </div>

                <button type="submit" class="btn btn-primary" disabled="@IsBusy"><Icon Name="check-circle" />@(IsBusy ? "Saving..." : "Save")</button>
            </EditForm>
        </div>
    }
    else
    {
        <dl>
            <dt>Category</dt>
            <dd>@Item.Category</dd>
            <dt>Serial number</dt>
            <dd>@Item.SerialNumber</dd>
            <dt>Site</dt>
            <dd>@Item.Site</dd>
        </dl>
    }

    <p class="status-line">Status: @Item.Status</p>

    @if (CanChangeStatus)
    {
        <div class="button-row">
            @if (Item.Status == EquipmentStatus.Active)
            {
                <button class="btn btn-danger" disabled="@IsBusy" @onclick="() => RetireConfirm!.Show()"><Icon Name="x-circle" />Retire</button>
            }
            else
            {
                <button class="btn btn-primary" disabled="@IsBusy" @onclick="ReactivateAsync"><Icon Name="check-circle" />@(IsBusy ? "Reactivating..." : "Reactivate")</button>
            }
        </div>
    }

    <h2><Icon Name="image" />Photo</h2>
    <div class="card">
        @if (Photo is not null)
        {
            <img class="equipment-photo-preview" src="@DocumentHref(Photo)" alt="@Item.Name" />
        }
        else
        {
            <p class="status-line">No photo set.</p>
        }

        @if (CanManageDocuments)
        {
            @if (Photo is null || ShowPhotoForm)
            {
                <div>
                    <label>Photo file <InputFile @key="PhotoInputKey" OnChange="OnPhotoFileSelected" accept=".jpg,.jpeg,.png,.webp" /></label>
                    @if (PhotoFileError is not null)
                    {
                        <p class="validation-message">@PhotoFileError</p>
                    }
                </div>
                <div class="button-row">
                    <button type="button" class="btn btn-primary" disabled="@(IsBusy || SelectedPhotoBytes is null)" @onclick="SavePhotoAsync"><Icon Name="check-circle" />@(IsBusy ? "Saving..." : "Save photo")</button>
                    @if (Photo is not null)
                    {
                        <button type="button" class="btn btn-ghost-light" @onclick="CancelPhotoForm"><Icon Name="x" />Cancel</button>
                    }
                </div>
            }
            else
            {
                <div class="button-row">
                    <button class="btn btn-ghost-light" @onclick="() => ShowPhotoForm = true"><Icon Name="image" />Replace</button>
                    <button class="btn btn-danger" disabled="@IsBusy" @onclick="() => RequestDeleteDocument(Photo)"><Icon Name="trash-2" />Remove</button>
                </div>
            }
        }
    </div>

    <h2><Icon Name="file-text" />Documents</h2>
    @if (OtherDocuments.Count == 0)
    {
        <p>No documents yet.</p>
    }
    else
    {
        <div class="table-card">
            <table>
                <thead>
                    <tr>
                        <th>Label</th>
                        <th>Link</th>
                        @if (CanManageDocuments)
                        {
                            <th></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doc in OtherDocuments)
                    {
                        <tr>
                            <td>@doc.Label</td>
                            <td><a class="open-link" href="@DocumentHref(doc)" target="_blank" rel="noopener noreferrer">Open<Icon Name="external-link" /></a></td>
                            @if (CanManageDocuments)
                            {
                                <td><button class="btn btn-danger" disabled="@IsBusy" @onclick="() => RequestDeleteDocument(doc)"><Icon Name="trash-2" />Delete</button></td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (CanManageDocuments)
    {
        <div class="form-card">
            <div>
                <label>Document file <InputFile @key="DocumentInputKey" OnChange="OnDocumentFileSelected" accept=".pdf,.doc,.docx,.xls,.xlsx" /></label>
                @if (DocumentFileError is not null)
                {
                    <p class="validation-message">@DocumentFileError</p>
                }
            </div>
            <button type="button" class="btn btn-primary" disabled="@(IsBusy || SelectedDocumentBytes is null)" @onclick="AddDocumentAsync"><Icon Name="upload" />@(IsBusy ? "Adding..." : "Add document")</button>
        </div>
    }

    <img class="qr-code" src="/equipment/@Item.Id/qr" alt="QR code for @Item.Name" width="240" height="240" />
    <p><a class="open-link" href="/e/@Item.Id" target="_blank" rel="noopener noreferrer">Public scan page<Icon Name="external-link" /></a></p>

    <ConfirmDialog @ref="RetireConfirm"
                    Title="Retire this equipment?"
                    Message="@($"\"{Item.Name}\" will be marked retired and hidden from the active equipment list.")"
                    ConfirmText="Retire"
                    OnConfirmed="RetireAsync" />

    <ConfirmDialog @ref="DeleteDocConfirm"
                    Title="@(PendingDelete is not null && Photo?.Id == PendingDelete.Id ? "Remove this photo?" : "Delete this document?")"
                    Message="@($"\"{PendingDelete?.Label}\" will be permanently removed.")"
                    ConfirmText="Delete"
                    OnConfirmed="DeleteDocumentAsync" />
}

@if (Error is not null)
{
    <p class="error"><Icon Name="x-circle" />@Error</p>
}

@code {
    [Parameter] public Guid Id { get; set; }

    protected override string[] AllowedRoles => [Roles.Admin, Roles.Operator, Roles.Reader];

    private Equipment? Item;
    private List<Category>? Categories;
    private readonly EditEquipmentModel Model = new();
    private string? Error;
    private string? CallerRole;
    private ConfirmDialog? RetireConfirm;
    private bool IsBusy;

    private List<Document>? Documents;
    private Document? Photo;
    private List<Document> OtherDocuments => (Documents ?? []).Where(d => d.Id != Photo?.Id).ToList();
    private bool ShowPhotoForm;
    private ConfirmDialog? DeleteDocConfirm;
    private Document? PendingDelete;

    private Guid PhotoInputKey = Guid.NewGuid();
    private byte[]? SelectedPhotoBytes;
    private string? SelectedPhotoContentType;
    private string? SelectedPhotoFileName;
    private string? PhotoFileError;

    private Guid DocumentInputKey = Guid.NewGuid();
    private byte[]? SelectedDocumentBytes;
    private string? SelectedDocumentContentType;
    private string? SelectedDocumentFileName;
    private string? DocumentFileError;

    private static string? DocumentHref(Document document) =>
        document.Content is not null ? $"/documents/{document.Id}/content" : document.Url;

    private bool CanEditNameAndSerialNumber => CallerRole == Roles.Admin;
    private bool CanEditCategoryAndSite => CallerRole == Roles.Operator;
    private bool CanChangeStatus => CallerRole == Roles.Admin;
    private bool CanManageDocuments => CallerRole == Roles.Admin || CallerRole == Roles.Operator;

    protected override async Task OnAuthorizedInitializedAsync(AppDbContext db)
    {
        var authState = await AuthenticationStateTask!;
        var email = authState.User.FindFirst(ClaimTypes.Email)?.Value;
        var caller = await UserAuthorization.FindAsync(email, db);
        CallerRole = caller?.Role;

        Item = await db.Equipment.FindAsync(Id);
        Categories = await db.Categories.OrderBy(c => c.Name).ToListAsync();

        if (Item is not null)
        {
            Model.Name = Item.Name;
            Model.Category = Item.Category;
            Model.SerialNumber = Item.SerialNumber;
            Model.Site = Item.Site;

            Documents = await DocumentCatalog.ListAsync(Id, db);
            Photo = Documents.FirstOrDefault(d => DocumentCatalog.IsPhotoLabel(d.Label));
        }
    }

    private async Task OnPhotoFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        PhotoFileError = DocumentUpload.Validate(file.Name, file.ContentType, file.Size, isPhoto: true);
        if (PhotoFileError is not null)
        {
            SelectedPhotoBytes = null;
            return;
        }

        using var stream = file.OpenReadStream(maxAllowedSize: DocumentUpload.MaxPhotoBytes);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        SelectedPhotoBytes = ms.ToArray();
        SelectedPhotoContentType = file.ContentType;
        SelectedPhotoFileName = file.Name;
    }

    private void CancelPhotoForm()
    {
        ShowPhotoForm = false;
        SelectedPhotoBytes = null;
        PhotoFileError = null;
        PhotoInputKey = Guid.NewGuid();
    }

    private async Task SavePhotoAsync()
    {
        if (SelectedPhotoBytes is null)
        {
            return;
        }

        Error = null;
        IsBusy = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await DocumentCatalog.SetPhotoUploadAsync(
                Id, SelectedPhotoBytes, SelectedPhotoContentType!, SelectedPhotoFileName!, db);
            switch (result)
            {
                case DocumentResult.Success success:
                    Photo = success.Document;
                    Documents = [.. (Documents ?? []).Where(d => d.Id != success.Document.Id), success.Document];
                    ShowPhotoForm = false;
                    SelectedPhotoBytes = null;
                    SelectedPhotoContentType = null;
                    SelectedPhotoFileName = null;
                    PhotoInputKey = Guid.NewGuid();
                    Toast.Success("Photo saved.");
                    break;
                case DocumentResult.InvalidFile invalid:
                    Error = invalid.Reason;
                    Toast.Error(Error);
                    break;
                default:
                    Error = "Could not save photo.";
                    Toast.Error(Error);
                    break;
            }
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task OnDocumentFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        DocumentFileError = DocumentUpload.Validate(file.Name, file.ContentType, file.Size, isPhoto: false);
        if (DocumentFileError is null && DocumentCatalog.IsPhotoLabel(Path.GetFileNameWithoutExtension(file.Name)))
        {
            DocumentFileError = "That file name is reserved for the equipment photo. Rename the file, or use the Photo section above.";
        }

        if (DocumentFileError is not null)
        {
            SelectedDocumentBytes = null;
            return;
        }

        using var stream = file.OpenReadStream(maxAllowedSize: DocumentUpload.MaxDocumentBytes);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        SelectedDocumentBytes = ms.ToArray();
        SelectedDocumentContentType = file.ContentType;
        SelectedDocumentFileName = file.Name;
    }

    private async Task AddDocumentAsync()
    {
        if (SelectedDocumentBytes is null)
        {
            return;
        }

        Error = null;
        IsBusy = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await DocumentCatalog.AddUploadAsync(
                Id, null, SelectedDocumentBytes, SelectedDocumentContentType!, SelectedDocumentFileName!, db);
            switch (result)
            {
                case DocumentResult.Success success:
                    Documents = [.. Documents ?? [], success.Document];
                    SelectedDocumentBytes = null;
                    SelectedDocumentContentType = null;
                    SelectedDocumentFileName = null;
                    DocumentInputKey = Guid.NewGuid();
                    Toast.Success("Document added.");
                    break;
                case DocumentResult.InvalidFile invalid:
                    Error = invalid.Reason;
                    Toast.Error(Error);
                    break;
                default:
                    Error = "Could not add document.";
                    Toast.Error(Error);
                    break;
            }
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void RequestDeleteDocument(Document? document)
    {
        if (document is null)
        {
            return;
        }

        PendingDelete = document;
        DeleteDocConfirm!.Show();
    }

    private async Task DeleteDocumentAsync()
    {
        if (PendingDelete is null)
        {
            return;
        }

        Error = null;
        IsBusy = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await DocumentCatalog.DeleteAsync(PendingDelete.Id, db);
            switch (result)
            {
                case DocumentResult.Success success:
                    Documents = (Documents ?? []).Where(d => d.Id != success.Document.Id).ToList();
                    if (Photo?.Id == success.Document.Id)
                    {
                        Photo = null;
                        SelectedPhotoBytes = null;
                        PhotoInputKey = Guid.NewGuid();
                    }
                    Toast.Success("Document deleted.");
                    break;
                default:
                    Error = "Could not delete document.";
                    Toast.Error(Error);
                    break;
            }
        }
        finally
        {
            IsBusy = false;
            PendingDelete = null;
        }
    }

    private async Task SaveAsync()
    {
        Error = null;
        IsBusy = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var request = new CreateEquipmentRequest(Model.Name, Model.Category, Model.SerialNumber, Model.Site);
            var result = await EquipmentCatalog.UpdateAsync(Id, request, CallerRole ?? "", db);
            HandleResult(result, "Equipment saved.");
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task RetireAsync()
    {
        Error = null;
        IsBusy = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await EquipmentCatalog.RetireAsync(Id, db);
            HandleResult(result, "Equipment retired.");
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task ReactivateAsync()
    {
        Error = null;
        IsBusy = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await EquipmentCatalog.ReactivateAsync(Id, db);
            HandleResult(result, "Equipment reactivated.");
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void HandleResult(EquipmentResult result, string successMessage)
    {
        switch (result)
        {
            case EquipmentResult.Success success:
                Item = success.Equipment;
                Model.Name = success.Equipment.Name;
                Model.Category = success.Equipment.Category;
                Model.SerialNumber = success.Equipment.SerialNumber;
                Model.Site = success.Equipment.Site;
                Toast.Success(successMessage);
                break;
            case EquipmentResult.UnknownCategory unknown:
                Error = $"Unknown category: {unknown.Category}";
                Toast.Error(Error);
                break;
            case EquipmentResult.RestrictedFieldEdit:
                Error = "Operators can only edit Category and Site.";
                Toast.Error(Error);
                break;
            default:
                Error = "Could not update equipment.";
                Toast.Error(Error);
                break;
        }
    }

    private sealed class EditEquipmentModel
    {
        [Required]
        public string Name { get; set; } = "";

        [Required]
        public string Category { get; set; } = "";

        [Required]
        public string SerialNumber { get; set; } = "";

        [Required]
        public string Site { get; set; } = "";
    }
}
