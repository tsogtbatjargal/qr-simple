@page "/app"
@attribute [Authorize]
@inherits RoleGatedComponentBase

<h1>Equipment</h1>

<a class="add-link" href="/app/equipment/add">+ Add equipment</a>

@if (AllEquipment is null)
{
    <p>Loading...</p>
}
else if (AllEquipment.Count == 0)
{
    <p>No equipment yet.</p>
}
else
{
    <div class="table-controls">
        <input class="search-input" type="search" placeholder="Search equipment..." @bind="SearchText" @bind:event="oninput" />
        <label class="checkbox-label"><input type="checkbox" @bind="ShowRetired" /> Show retired</label>
        <span class="result-count">@Visible.Count of @BaseVisible.Count</span>
    </div>

    <div class="table-card">
        <table>
            <thead>
                <tr>
                    <th class="sortable" @onclick="@(() => SetSort("Name"))">Name@(SortArrow("Name"))</th>
                    <th class="sortable" @onclick="@(() => SetSort("Category"))">Category@(SortArrow("Category"))</th>
                    <th class="sortable" @onclick="@(() => SetSort("Serial"))">Serial@(SortArrow("Serial"))</th>
                    <th class="sortable" @onclick="@(() => SetSort("Site"))">Site@(SortArrow("Site"))</th>
                    <th class="sortable" @onclick="@(() => SetSort("Status"))">Status@(SortArrow("Status"))</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Visible)
                {
                    <tr>
                        <td><a href="/app/equipment/@item.Id">@item.Name</a></td>
                        <td>@item.Category</td>
                        <td>@item.SerialNumber</td>
                        <td>@item.Site</td>
                        <td>@item.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    protected override string[] AllowedRoles => [Roles.Admin, Roles.Operator, Roles.Reader];

    // Loaded once including retired equipment so the "Show retired" toggle is instant
    // (no extra DB round-trip) — it also lets the count on CategoryDetail's "used by N
    // equipment" line be cross-checked against something visible in this UI, which was
    // not possible before this toggle existed.
    private List<Equipment>? AllEquipment;
    private string SearchText = "";
    private bool ShowRetired;
    private string SortColumn = "Name";
    private bool SortAscending = true;

    private List<Equipment> BaseVisible => ShowRetired
        ? AllEquipment ?? []
        : (AllEquipment ?? []).Where(e => e.Status == EquipmentStatus.Active).ToList();

    private List<Equipment> Visible => Sort(Filter(BaseVisible));

    protected override async Task OnAuthorizedInitializedAsync(AppDbContext db)
    {
        AllEquipment = await EquipmentCatalog.ListAsync(includeRetired: true, db);
    }

    private List<Equipment> Filter(List<Equipment> source)
    {
        if (string.IsNullOrWhiteSpace(SearchText))
        {
            return source;
        }

        var term = SearchText.Trim();
        return source.Where(e =>
            e.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
            e.Category.Contains(term, StringComparison.OrdinalIgnoreCase) ||
            e.SerialNumber.Contains(term, StringComparison.OrdinalIgnoreCase) ||
            e.Site.Contains(term, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private List<Equipment> Sort(List<Equipment> source)
    {
        Func<Equipment, string> key = SortColumn switch
        {
            "Category" => e => e.Category,
            "Serial" => e => e.SerialNumber,
            "Site" => e => e.Site,
            "Status" => e => e.Status.ToString(),
            _ => e => e.Name,
        };

        return SortAscending
            ? source.OrderBy(key, StringComparer.OrdinalIgnoreCase).ToList()
            : source.OrderByDescending(key, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private void SetSort(string column)
    {
        if (SortColumn == column)
        {
            SortAscending = !SortAscending;
        }
        else
        {
            SortColumn = column;
            SortAscending = true;
        }
    }

    private string SortArrow(string column) =>
        SortColumn != column ? "" : SortAscending ? " ▲" : " ▼";
}
