@page "/app/equipment/{Id:guid}/rebuilds"
@attribute [Authorize]
@inherits RoleGatedComponentBase

@if (Equipment is null)
{
    <p>Equipment not found.</p>
}
else
{
    <Breadcrumbs Items="@(new() { new("Equipment", "/app"), new(Equipment.Name, $"/app/equipment/{Id}"), new("Rebuild history") })" />

    <h1>@Equipment.Name</h1>
    <p class="status-line">@Equipment.SerialNumber &middot; Rebuild history</p>

    @if (CanManageRebuilds)
    {
        @if (Equipment.Status == EquipmentStatus.Retired)
        {
            <p class="status-line">This equipment is retired; new rebuild records cannot be added.</p>
        }
        else
        {
            <div class="form-card">
                <div>
                    <label>Rebuild date <InputDate @bind-Value="NewDate" /></label>
                </div>
                <div>
                    <label>Note <InputTextArea @bind-Value="NewNote" maxlength="1000" /></label>
                    @if (NoteError is not null)
                    {
                        <p class="validation-message">@NoteError</p>
                    }
                </div>
                <div>
                    <label>PDF file (optional) <InputFile @key="FileInputKey" OnChange="OnFileSelected" accept=".pdf" /></label>
                    @if (FileError is not null)
                    {
                        <p class="validation-message">@FileError</p>
                    }
                </div>
                <button type="button" class="btn btn-primary" disabled="@IsBusy" @onclick="AddAsync"><Icon Name="plus" />@(IsBusy ? "Saving..." : "Add rebuild record")</button>
            </div>
        }
    }

    @if (Rebuilds is null || Rebuilds.Count == 0)
    {
        <p>No rebuild records yet.</p>
    }
    else
    {
        <div class="table-card">
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Note</th>
                        <th>PDF</th>
                        <th>Uploaded by</th>
                        <th>Last edited</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Rebuilds)
                    {
                        @if (EditingId == item.Id)
                        {
                            <tr>
                                <td colspan="6">
                                    <EditForm Model="EditModel" OnValidSubmit="() => SaveEditAsync(item.Id)">
                                        <DataAnnotationsValidator />
                                        <ValidationSummary />
                                        <div>
                                            <label>Rebuild date <InputDate @bind-Value="EditModel.RebuildDate" /></label>
                                        </div>
                                        <div>
                                            <label>Note <InputTextArea @bind-Value="EditModel.Note" maxlength="1000" /></label>
                                        </div>
                                        <div class="button-row">
                                            <button type="submit" class="btn btn-primary" disabled="@IsBusy"><Icon Name="check-circle" />@(IsBusy ? "Saving..." : "Save")</button>
                                            <button type="button" class="btn btn-ghost-light" @onclick="CancelEdit"><Icon Name="x" />Cancel</button>
                                        </div>
                                    </EditForm>
                                </td>
                            </tr>
                        }
                        else if (AttachingId == item.Id)
                        {
                            <tr>
                                <td colspan="6">
                                    <div>
                                        <label>PDF file <InputFile @key="AttachInputKey" OnChange="OnAttachFileSelected" accept=".pdf" /></label>
                                        @if (AttachError is not null)
                                        {
                                            <p class="validation-message">@AttachError</p>
                                        }
                                    </div>
                                    <div class="button-row">
                                        <button type="button" class="btn btn-primary" disabled="@(IsBusy || AttachBytes is null)" @onclick="() => SaveAttachAsync(item.Id)"><Icon Name="upload" />@(IsBusy ? "Uploading..." : "Attach PDF")</button>
                                        <button type="button" class="btn btn-ghost-light" @onclick="CancelAttach"><Icon Name="x" />Cancel</button>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td>@item.RebuildDate.ToString("d MMM yyyy")</td>
                                <td>@item.Note</td>
                                <td>
                                    @if (item.HasFile)
                                    {
                                        <a class="open-link" href="/rebuilds/@item.Id/content" target="_blank" rel="noopener noreferrer">Open<Icon Name="external-link" /></a>
                                    }
                                    else if (CanEdit(item))
                                    {
                                        <button class="btn btn-ghost-light" @onclick="() => StartAttach(item)"><Icon Name="upload" />Attach PDF</button>
                                    }
                                    else
                                    {
                                        <span class="status-line">None</span>
                                    }
                                </td>
                                <td>@item.UploadedByEmail</td>
                                <td>@LastEditedLabel(item)</td>
                                <td>
                                    @if (CanEdit(item))
                                    {
                                        <button class="btn btn-ghost-light" @onclick="() => StartEdit(item)"><Icon Name="pencil" />Edit</button>
                                    }
                                    @if (CallerRole == Roles.Admin)
                                    {
                                        <button class="btn btn-danger" disabled="@IsBusy" @onclick="() => RequestDelete(item)"><Icon Name="trash-2" />Delete</button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }

    <p><a class="open-link" href="/e/@Equipment.Id/rebuilds" target="_blank" rel="noopener noreferrer">Public rebuild history page<Icon Name="external-link" /></a></p>

    <ConfirmDialog @ref="DeleteConfirm"
                    Title="Delete this rebuild record?"
                    Message="@PendingDeleteMessage"
                    ConfirmText="Delete"
                    OnConfirmed="DeleteAsync" />
}

@if (Error is not null)
{
    <p class="error"><Icon Name="x-circle" />@Error</p>
}

@code {
    [Parameter] public Guid Id { get; set; }

    protected override string[] AllowedRoles => [Roles.Admin, Roles.Operator, Roles.Reader];

    private Equipment? Equipment;
    private List<RebuildListItem>? Rebuilds;
    private string? CallerRole;
    private string? CallerEmail;
    private string? Error;
    private bool IsBusy;

    private DateOnly NewDate = BusinessTime.Today();
    private string? NewNote;
    private string? NoteError;
    private Guid FileInputKey = Guid.NewGuid();
    private byte[]? SelectedBytes;
    private string? SelectedContentType;
    private string? SelectedFileName;
    private string? FileError;

    private Guid? EditingId;
    private readonly EditRebuildModel EditModel = new();

    private Guid? AttachingId;
    private Guid AttachInputKey = Guid.NewGuid();
    private byte[]? AttachBytes;
    private string? AttachContentType;
    private string? AttachFileName;
    private string? AttachError;

    private ConfirmDialog? DeleteConfirm;
    private RebuildListItem? PendingDelete;

    // Formatted here rather than inline in the ConfirmDialog Message attribute: a format
    // specifier inside an interpolated string inside a component attribute (`{X:d MMM yyyy}`)
    // silently stops the Razor source generator emitting *any* .razor.g.cs for the project. It
    // reports no error of its own — you get a wall of "namespace Components.Shared does not
    // exist" instead, which points nowhere near the real line.
    private string PendingDeleteMessage =>
        PendingDelete is null
            ? ""
            : $"The rebuild record from {PendingDelete.RebuildDate.ToString("d MMM yyyy")} will be permanently removed.";

    private bool CanManageRebuilds => CallerRole == Roles.Admin || CallerRole == Roles.Operator;

    private bool CanEdit(RebuildListItem item) =>
        CallerRole == Roles.Admin ||
        (CallerRole == Roles.Operator && string.Equals(item.UploadedByEmail, CallerEmail, StringComparison.OrdinalIgnoreCase));

    private static string LastEditedLabel(RebuildListItem item) =>
        item.LastEditedAtUtc is null
            ? ""
            : $"{item.LastEditedByEmail} ({BusinessTime.ToBusiness(item.LastEditedAtUtc.Value):d MMM yyyy})";

    protected override async Task OnAuthorizedInitializedAsync(AppDbContext db)
    {
        var authState = await AuthenticationStateTask!;
        var caller = await UserAuthorization.FindAsync(authState.User.FindFirst(ClaimTypes.Email)?.Value, db);
        CallerRole = caller?.Role;
        CallerEmail = caller?.Email;

        Equipment = await db.Equipment.FindAsync(Id);
        if (Equipment is not null)
        {
            Rebuilds = await RebuildCatalog.ListAsync(Id, db);
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        FileError = DocumentUpload.Validate(file.Name, file.ContentType, file.Size, UploadKind.Rebuild);
        if (FileError is not null)
        {
            SelectedBytes = null;
            return;
        }

        using var stream = file.OpenReadStream(maxAllowedSize: DocumentUpload.MaxRebuildBytes);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        SelectedBytes = ms.ToArray();
        SelectedContentType = file.ContentType;
        SelectedFileName = file.Name;
    }

    private async Task AddAsync()
    {
        // The PDF is optional but the note is not, so catch the empty note here rather than
        // round-tripping to the catalog just to render the same message.
        NoteError = string.IsNullOrWhiteSpace(NewNote) ? "Note is required." : null;
        if (NoteError is not null)
        {
            return;
        }

        Error = null;
        IsBusy = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await RebuildCatalog.AddAsync(
                Id, NewDate, NewNote, SelectedBytes, SelectedContentType, SelectedFileName, CallerEmail!, db);

            switch (result)
            {
                case RebuildResult.Success:
                    Rebuilds = await RebuildCatalog.ListAsync(Id, db);
                    NewDate = BusinessTime.Today();
                    NewNote = null;
                    SelectedBytes = null;
                    SelectedContentType = null;
                    SelectedFileName = null;
                    FileInputKey = Guid.NewGuid();
                    Toast.Success("Rebuild record added.");
                    break;
                case RebuildResult.InvalidFile invalid:
                    Error = invalid.Reason;
                    Toast.Error(Error);
                    break;
                case RebuildResult.InvalidRequest invalid:
                    Error = invalid.Reason;
                    Toast.Error(Error);
                    break;
                case RebuildResult.Forbidden forbidden:
                    Error = forbidden.Reason;
                    Toast.Error(Error);
                    break;
                default:
                    Error = "Could not add rebuild record.";
                    Toast.Error(Error);
                    break;
            }
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void StartEdit(RebuildListItem item)
    {
        CancelAttach();
        EditingId = item.Id;
        EditModel.RebuildDate = item.RebuildDate;
        EditModel.Note = item.Note;
    }

    private void CancelEdit()
    {
        EditingId = null;
    }

    private async Task SaveEditAsync(Guid rebuildId)
    {
        Error = null;
        IsBusy = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await RebuildCatalog.EditAsync(
                rebuildId, EditModel.RebuildDate, EditModel.Note, CallerEmail!, CallerRole!, db);

            switch (result)
            {
                case RebuildResult.Success:
                    Rebuilds = await RebuildCatalog.ListAsync(Id, db);
                    EditingId = null;
                    Toast.Success("Rebuild record updated.");
                    break;
                case RebuildResult.InvalidRequest invalid:
                    Error = invalid.Reason;
                    Toast.Error(Error);
                    break;
                case RebuildResult.Forbidden forbidden:
                    Error = forbidden.Reason;
                    Toast.Error(Error);
                    break;
                default:
                    Error = "Could not update rebuild record.";
                    Toast.Error(Error);
                    break;
            }
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void StartAttach(RebuildListItem item)
    {
        CancelEdit();
        AttachingId = item.Id;
        AttachBytes = null;
        AttachError = null;
        AttachInputKey = Guid.NewGuid();
    }

    private void CancelAttach()
    {
        AttachingId = null;
        AttachBytes = null;
        AttachError = null;
    }

    private async Task OnAttachFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        AttachError = DocumentUpload.Validate(file.Name, file.ContentType, file.Size, UploadKind.Rebuild);
        if (AttachError is not null)
        {
            AttachBytes = null;
            return;
        }

        using var stream = file.OpenReadStream(maxAllowedSize: DocumentUpload.MaxRebuildBytes);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        AttachBytes = ms.ToArray();
        AttachContentType = file.ContentType;
        AttachFileName = file.Name;
    }

    private async Task SaveAttachAsync(Guid rebuildId)
    {
        if (AttachBytes is null)
        {
            return;
        }

        Error = null;
        IsBusy = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await RebuildCatalog.AttachFileAsync(
                rebuildId, AttachBytes, AttachContentType!, AttachFileName!, CallerEmail!, CallerRole!, db);

            switch (result)
            {
                case RebuildResult.Success:
                    Rebuilds = await RebuildCatalog.ListAsync(Id, db);
                    CancelAttach();
                    Toast.Success("PDF attached.");
                    break;
                case RebuildResult.InvalidFile invalid:
                    AttachError = invalid.Reason;
                    Toast.Error(AttachError);
                    break;
                case RebuildResult.Forbidden forbidden:
                    AttachError = forbidden.Reason;
                    Toast.Error(AttachError);
                    break;
                default:
                    AttachError = "Could not attach PDF.";
                    Toast.Error(AttachError);
                    break;
            }
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void RequestDelete(RebuildListItem item)
    {
        PendingDelete = item;
        DeleteConfirm!.Show();
    }

    private async Task DeleteAsync()
    {
        if (PendingDelete is null)
        {
            return;
        }

        Error = null;
        IsBusy = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await RebuildCatalog.DeleteAsync(PendingDelete.Id, db);
            switch (result)
            {
                case RebuildResult.Success:
                    Rebuilds = await RebuildCatalog.ListAsync(Id, db);
                    Toast.Success("Rebuild record deleted.");
                    break;
                default:
                    Error = "Could not delete rebuild record.";
                    Toast.Error(Error);
                    break;
            }
        }
        finally
        {
            IsBusy = false;
            PendingDelete = null;
        }
    }

    private sealed class EditRebuildModel
    {
        public DateOnly RebuildDate { get; set; }
        public string? Note { get; set; }
    }
}
