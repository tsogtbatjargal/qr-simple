@page "/app/users/{Id:guid}"
@attribute [Authorize]
@inherits RoleGatedComponentBase

@if (Item is null)
{
    <p>User not found.</p>
}
else
{
    <h1>@Item.Email</h1>
    <p class="status-line">Status: @(Item.IsActive ? "Active" : "Inactive")</p>

    <div class="form-card">
        <EditForm Model="Model" OnValidSubmit="SaveRoleAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div>
                <label>
                    Role
                    <InputSelect @bind-Value="Model.Role">
                        @foreach (var role in Roles.All)
                        {
                            <option value="@role">@role</option>
                        }
                    </InputSelect>
                </label>
            </div>

            <button type="submit" class="btn btn-primary">Save role</button>
        </EditForm>
    </div>

    <div class="button-row">
        @if (Item.IsActive)
        {
            <button class="btn btn-danger" @onclick="() => DeactivateConfirm!.Show()">Deactivate</button>
        }
        else
        {
            <button class="btn btn-primary" @onclick="ReactivateAsync">Reactivate</button>
        }
    </div>

    <ConfirmDialog @ref="DeactivateConfirm"
                    Title="Deactivate this user?"
                    Message="@($"\"{Item.Email}\" will lose access to qr-simple until reactivated.")"
                    ConfirmText="Deactivate"
                    OnConfirmed="DeactivateAsync" />
}

@if (Error is not null)
{
    <p class="error">@Error</p>
}

<p><a href="/app/users">Back to users</a></p>

@code {
    [Parameter] public Guid Id { get; set; }

    protected override string[] AllowedRoles => [Roles.Admin];

    private User? Item;
    private readonly EditRoleModel Model = new();
    private string? Error;
    private string? CallerEmail;
    private ConfirmDialog? DeactivateConfirm;

    protected override async Task OnAuthorizedInitializedAsync(AppDbContext db)
    {
        var authState = await AuthenticationStateTask!;
        CallerEmail = authState.User.FindFirst(ClaimTypes.Email)?.Value;

        Item = await db.Users.FindAsync(Id);
        if (Item is not null)
        {
            Model.Role = Item.Role;
        }
    }

    private async Task SaveRoleAsync()
    {
        Error = null;
        await using var db = await DbFactory.CreateDbContextAsync();
        var result = await UserCatalog.UpdateRoleAsync(Id, Model.Role, db);
        HandleResult(result, "Role saved.");
    }

    private async Task DeactivateAsync()
    {
        Error = null;
        await using var db = await DbFactory.CreateDbContextAsync();
        var result = await UserCatalog.DeactivateAsync(Id, CallerEmail, db);
        HandleResult(result, "User deactivated.");
    }

    private async Task ReactivateAsync()
    {
        Error = null;
        await using var db = await DbFactory.CreateDbContextAsync();
        var result = await UserCatalog.ReactivateAsync(Id, db);
        HandleResult(result, "User reactivated.");
    }

    private void HandleResult(UserResult result, string successMessage)
    {
        switch (result)
        {
            case UserResult.Success success:
                Item = success.User;
                Model.Role = success.User.Role;
                Toast.Show(successMessage);
                break;
            case UserResult.LastAdminProtected:
                Error = "Cannot remove the last remaining Admin.";
                break;
            case UserResult.SelfLockoutBlocked:
                Error = "You cannot deactivate your own account.";
                break;
            case UserResult.UnknownRole unknown:
                Error = $"Unknown role: {unknown.Role}";
                break;
            default:
                Error = "Could not update user.";
                break;
        }
    }

    private sealed class EditRoleModel
    {
        [Required]
        public string Role { get; set; } = "";
    }
}
