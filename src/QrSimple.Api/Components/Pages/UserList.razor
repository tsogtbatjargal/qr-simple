@page "/app/users"
@attribute [Authorize]
@inherits RoleGatedComponentBase

<h1>Users</h1>

<p><a href="/app/users/add">+ Add user</a></p>

@if (Users is null)
{
    <p>Loading...</p>
}
else if (Users.Count == 0)
{
    <p>No users yet.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Users)
            {
                <tr>
                    <td><a href="/app/users/@item.Id">@item.Email</a></td>
                    <td>@item.Role</td>
                    <td>@(item.IsActive ? "Active" : "Inactive")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    protected override string[] AllowedRoles => [Roles.Admin];
    private List<User>? Users;

    protected override async Task OnAuthorizedInitializedAsync(AppDbContext db)
    {
        Users = await db.Users.OrderBy(u => u.Email).ToListAsync();
    }
}
