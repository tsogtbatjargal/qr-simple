<nav class="breadcrumbs" aria-label="Breadcrumb">
    @for (var i = 0; i < Items.Count; i++)
    {
        var item = Items[i];
        if (i > 0)
        {
            <span class="sep" aria-hidden="true"><Icon Name="chevron-right" /></span>
        }
        if (item.Href is not null && i < Items.Count - 1)
        {
            <a href="@item.Href">@item.Text</a>
        }
        else
        {
            <span class="current">@item.Text</span>
        }
    }
</nav>

@code {
    [Parameter, EditorRequired] public List<Crumb> Items { get; set; } = [];

    public sealed record Crumb(string Text, string? Href = null);
}
