<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>b1a96fde-ea71-4042-810e-3c5ed008f005</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Explicit reference required for a clean/fresh restore (e.g. Docker builds,
      CI runners) to correctly discover Blazor's framework static assets
      (blazor.web.js, blazor.server.js). Without it, dotnet publish silently
      produces an empty staticwebassets.endpoints.json and no wwwroot/_framework
      folder at all: the app still builds and boots fine, but every interactive
      Blazor nav click breaks post-deploy (404 on the framework script).
      Normally the SDK resolves this package implicitly from the installed
      shared framework version; that implicit resolution did not happen for
      this project's exact SDK/environment combination, even with matching SDK
      versions and a public nuget.org-only feed. Version pinned to match the
      other net10.0 packages above; bump together with them.
    -->
    <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" Version="10.0.10" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- Microsoft.AspNetCore.OpenApi 10.0.10 transitively pulls Microsoft.OpenApi
         2.0.0, which has a known high-severity vulnerability (stack overflow on
         a circular schema reference, GHSA-v5pm-xwqc-g5wc; fixed in 2.7.5+).
         Overriding to the latest 2.x patch, not jumping to 3.x, since 3.x is a
         new major line Microsoft.AspNetCore.OpenApi 10.0.10 wasn't built against. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.1" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="ZXing.Net.Bindings.SkiaSharp" Version="0.16.22" />
  </ItemGroup>

</Project>
